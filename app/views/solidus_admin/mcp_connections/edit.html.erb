<%= stylesheet_link_tag "solidus_mcp/admin", "data-turbo-track": "reload" %>
<div class="solidus-mcp-admin">
  <%= link_to "All AI connections", solidus_admin.mcp_connections_path, class: "solidus-mcp-link" %>
  <h1 class="solidus-mcp-connection-title"><%= @application.name %></h1>
  <p class="solidus-mcp-connected-by">Connected by <strong><%= @user.email %></strong></p>
  <p class="solidus-mcp-notice">Changes apply to this person's connection, including refreshed tokens. An unchecked permission blocks every tool that needs it.</p>
  <p class="solidus-mcp-intro">Scopes on active tokens (tokens may differ): <%= @scopes.presence&.join(", ") || "No unexpired access tokens. Reconnect or refresh to use this connection." %>. Enabling a permission here does not add scopes to an existing token.</p>

  <% if @policy.deleted_at? %>
    <p class="solidus-mcp-notice">This permission set was deleted and access is disabled. <%= manage_connection_permissions? ? "To restore it, choose permissions, enable the connection, and select Restore permission set." : "Ask an MCP administrator to restore it." %> OAuth scope limits still apply.</p>
  <% end %>

  <% if manage_connection_permissions? %>
    <%= form_with url: solidus_admin.mcp_connection_path(@application, user_id: @user.id), method: :patch, local: true do %>
      <%= hidden_field_tag "connection_policy[lock_version]", @policy.persisted? ? @policy.lock_version : -1 %>
      <%= hidden_field_tag "connection_policy[enabled]", "0", id: nil %>
      <label class="solidus-mcp-connection-toggle">
        <%= check_box_tag "connection_policy[enabled]", "1", @policy.enabled? %>
        Connection enabled
      </label>
      <%= hidden_field_tag "connection_policy[permissions][]", "", id: nil %>
      <%= render "solidus_admin/mcp_connections/permissions" %>
      <%= submit_tag(@policy.deleted_at? ? "Restore permission set" : "Save permissions", class: "solidus-mcp-button solidus-mcp-button-primary") %>
    <% end %>
  <% else %>
    <p class="solidus-mcp-notice"><%= mcp_administrator? ? "This is a privileged connection. An MCP superadministrator manages its permissions, including your own grants." : "You are an MCP user. An MCP administrator manages your tool permissions and connection access." %></p>
    <p><strong>Connection status:</strong> <%= @policy.deleted_at? ? "Deleted" : (@policy.enabled? ? "Enabled" : "Disabled") %></p>
    <%= render "solidus_admin/mcp_connections/permissions" %>
  <% end %>

  <% if manage_connection_permissions? && !@policy.deleted_at? %>
    <section class="solidus-mcp-section" aria-labelledby="delete-permissions-heading">
      <h2 id="delete-permissions-heading">Delete permission set</h2>
      <p>Remove all tool permissions and disable this connection. The permission set moves to Deleted permission sets; its audit history is retained. Other users and OAuth client registrations are unaffected.</p>
      <%= form_with url: solidus_admin.mcp_connection_path(@application, user_id: @user.id), method: :delete, local: true, data: {turbo_confirm: "Delete this permission set and disable its access?"} do %>
        <%= hidden_field_tag "connection_policy[lock_version]", @policy.persisted? ? @policy.lock_version : -1, id: nil %>
        <%= submit_tag "Delete permission set", class: "solidus-mcp-button" %>
      <% end %>
    </section>
  <% end %>

  <section class="solidus-mcp-section" aria-labelledby="reconnect-heading">
    <h2 id="reconnect-heading">Reconnect to authorize additional access</h2>
    <p>Saving permissions here does not expand OAuth consent. The person who connected this application must start Reconnect or Authorize again in their MCP client, request the required scopes, and approve them on the store's consent screen. Then refresh the client's tool list.</p>
    <p>Refreshing an existing token cannot add scopes. An expired token can be refreshed only with the access previously authorized. Reconnecting does not automatically enable any store permissions.</p>
  </section>

  <h2 class="solidus-mcp-audit-heading">Recent permission changes</h2>
  <% if @changes.empty? %><p>No permission changes recorded.</p><% end %>
  <% @changes.each do |change| %>
    <details class="solidus-mcp-audit-entry">
      <summary><%= change.created_at.iso8601 %> — administrator #<%= change.actor_id %></summary>
      <% if change.new_values["deleted_at"].present? %><p>Permission set deleted.</p><% elsif change.previous_values["deleted_at"].present? %><p>Permission set restored.</p><% end %>
      <p>Enabled: <%= change.previous_values["enabled"] %> → <%= change.new_values["enabled"] %></p>
      <p>Removed: <%= (change.previous_values["permissions"] - change.new_values["permissions"]).join(", ").presence || "None" %></p>
      <p>Added: <%= (change.new_values["permissions"] - change.previous_values["permissions"]).join(", ").presence || "None" %></p>
    </details>
  <% end %>
</div>
